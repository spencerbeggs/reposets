{
	"integration": {
		"ci": {
			"enabled": false,
			"syncOnMerge": false,
			"validateOnPR": false
		},
		"git": {
			"requireReviewForChanges": false,
			"trackDesignDocs": true
		}
	},
	"modules": {
		"reposets": {
			"categories": ["architecture", "process", "testing", "other"],
			"designDocsPath": ".claude/design/reposets",
			"maintainer": "C. Spencer Beggs",
			"path": "package"
		}
	},
	"paths": {
		"context": "CLAUDE.md",
		"designDocs": ".claude/design",
		"skills": ".claude/skills"
	},
	"project": {
		"maintainer": "C. Spencer Beggs",
		"name": "spencerbeggs/reposets",
		"repository": "https://github.com/spencerbeggs/reposets",
		"type": "monorepo"
	},
	"quality": {
		"designDocs": {
			"maxLineLength": 120,
			"minSections": ["Overview"],
			"requireFrontmatter": true,
			"requireTOC": false
		}
	},
	"skills": {
		"baseNamespace": "/",
		"enabled": [
			"design-init",
			"design-validate",
			"design-update",
			"design-sync",
			"design-review",
			"design-audit",
			"design-search",
			"design-report"
		]
	},
	"version": "1.0.0"
}
