{
	"name": "reposets",
	"version": "4.0.7",
	"description": "CLI tool to sync GitHub repo settings, secrets and rulesets across personal repositories",
	"keywords": [
		"github",
		"sync",
		"cli",
		"secrets",
		"rulesets",
		"variables",
		"environments",
		"toml",
		"effect",
		"xdg",
		"repository",
		"settings",
		"automation",
		"devops"
	],
	"homepage": "https://github.com/spencerbeggs/reposets#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/reposets/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/reposets.git",
		"directory": "package"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"reposets": "./src/cli/bin.ts"
	},
	"scripts": {
		"build": "effected package build",
		"schema:build": "effected schema build lib/configs/schemastore.config.ts",
		"schema:check": "effected schema check lib/configs/schemastore.config.ts",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@1password/sdk": "^0.5.0",
		"@effect/platform-node": "catalog:effected",
		"@effected/app": "catalog:effected",
		"@effected/cli-kit": "catalog:effected",
		"@effected/config-file": "catalog:effected",
		"@effected/env": "catalog:effected",
		"@effected/files": "catalog:effected",
		"@effected/github": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/schemastore": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"blakejs": "^1.2.1",
		"effect": "catalog:effected",
		"ink": "catalog:silk",
		"react": "catalog:effected:build"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effected",
		"@effected/memfs": "catalog:effected",
		"@effected/plugin": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"@types/react": "catalog:effected:build",
		"typescript": "catalog:effected:build"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true,
			"github": "@spencerbeggs/reposets"
		}
	}
}
