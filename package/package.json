{
	"name": "reposets",
	"version": "1.0.17",
	"description": "CLI tool to sync GitHub repo settings, secrets and rulesets across personal repositories",
	"keywords": [
		"github",
		"sync",
		"cli",
		"secrets",
		"rulesets",
		"variables",
		"environments",
		"toml",
		"effect",
		"xdg",
		"repository",
		"settings",
		"automation",
		"devops"
	],
	"homepage": "https://github.com/spencerbeggs/reposets#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/reposets/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/reposets.git",
		"directory": "package"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"reposets": "./src/cli/index.ts"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "node savvy.build.ts --target dev",
		"schema:build": "schemastore build lib/configs/schemastore.config.ts",
		"schema:check": "schemastore check lib/configs/schemastore.config.ts",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@1password/sdk": "^0.5.0",
		"@effect/platform-node": "catalog:effect",
		"@effected/app": "catalog:effected",
		"@effected/config-file": "catalog:effected",
		"@effected/github": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"blakejs": "^1.2.1",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@effected/schemastore": "catalog:effected",
		"@effected/schemastore-cli": "catalog:effected",
		"@savvy-web/bundler": "^2.4.6",
		"@types/node": "catalog:build",
		"typescript": "catalog:build"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true,
			"github": "@spencerbeggs/reposets"
		}
	}
}
